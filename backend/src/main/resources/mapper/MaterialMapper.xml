<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xiaoying.studio.material.MaterialMapper">
  <insert id="insert" useGeneratedKeys="true" keyProperty="id">
    INSERT INTO material(user_id,original_name,mime_type,size_bytes,sha256,storage_key,created_at)
    VALUES(#{userId},#{originalName},#{mimeType},#{sizeBytes},#{sha256},#{storageKey},#{createdAt})
  </insert>
  <select id="owned" resultType="com.xiaoying.studio.material.MaterialRow">
    SELECT * FROM material WHERE id=#{id} AND user_id=#{userId}
  </select>
</mapper>
